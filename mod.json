
{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "version": "v1.0.0",
  "id": "max.cheat-pro",
  "name": "MAX CHEAT PRO",
  "developer": "Max",
  "description": "MAX CHEAT PRO - floating menu with custom click sounds and gameplay settings.",
  "settings": {
    "floating-button": {
      "name": "Плавающая кнопка",
      "description": "Показывать плавающую кнопку меню",
      "type": "bool",
      "default": true
    },
    "menu-opacity": {
      "name": "Прозрачность меню",
      "description": "Прозрачность окна меню",
      "type": "int",
      "default": 80,
      "min": 10,
      "max": 100
    },
    "click-sound": {
      "name": "Звук кликов",
      "description": "Включить звук нажатий",
      "type": "bool",
      "default": true
    },
    "custom-click": {
      "name": "Свой звук MP3",
      "description": "Выбрать собственный звук",
      "type": "file",
      "default": "",
      "control": {
        "dialog": "open",
        "filters": [
          {
            "files": ["*.mp3"],
            "description": "MP3 Audio"
          }
        ]
      }
    },
    "click-volume": {
      "name": "Громкость клика",
      "description": "Громкость звука нажатия",
      "type": "int",
      "default": 70,
      "min": 0,
      "max": 80
    }
  },
  "dependencies": {}
}
